# Workaholic web app — browser-safe configuration only.
# Copy to `.env.local` for local development. Everything here is bundled into public JavaScript:
# never put a secret key in this file.

# Supabase → Project Settings → API Keys (publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Workaholic API (local: `pnpm dev:api`)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Show "Continue with Google" once the Google provider is enabled in Supabase
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
