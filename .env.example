# Workaholic — backend / local infrastructure environment
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# Frontend variables live in apps/web/.env.local (see apps/web/.env.example).

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ── Database (docker-compose Postgres) ───────────────────────
DATABASE_URL=postgresql+asyncpg://workaholic:workaholic@127.0.0.1:5432/workaholic
# Used only by the test suite; created automatically by docker-compose
TEST_DATABASE_URL=postgresql+asyncpg://workaholic:workaholic@127.0.0.1:5432/workaholic_test

# ── Redis (docker-compose Redis) ─────────────────────────────
# Optional: only needed once background jobs or rate limiting ship.
REDIS_URL=redis://127.0.0.1:6379/0

# ── Auth: Supabase (Project Settings → API Keys) ─────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-side only. Bypasses all access rules — never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# ── AI provider (docs/architecture/ai-platform.md) ───────────
# disabled | azure | openai_compatible
AI_PROVIDER=disabled

# Azure / Microsoft Foundry — keyless by default (az login locally, managed identity in Azure)
AZURE_AI_ENDPOINT=https://workaholic-ai-frc.openai.azure.com
# The deployment name to call (benchmarked default: gpt-5-mini)
AZURE_AI_MODEL=gpt-5-mini
AZURE_AI_AUTH=entra_id
# Only when AZURE_AI_AUTH=api_key (not recommended)
AZURE_AI_API_KEY=
# Set in Azure Container Apps to the user-assigned managed identity's client ID
AZURE_CLIENT_ID=

# Any OpenAI-compatible provider (Groq, Gemini, Mistral, ...) when AI_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Development/benchmark providers — fictional data only (free tiers may train on inputs).
# Select with AI_PROVIDER=gemini | groq | mistral | openrouter. Refused in production.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Cost and reliability controls
AI_MAX_OUTPUT_TOKENS=4000
# Benchmarked default for gpt-5-mini; leave empty for non-reasoning models such as gpt-4.1-mini
AI_REASONING_EFFORT=low
AI_STRUCTURED_OUTPUT_ATTEMPTS=2

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
