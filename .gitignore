# Secrets — never commit real environment files
.env
.env.*
!.env.example
*.pem

# Node / Next.js
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan

# Test artifacts
playwright-report/
test-results/

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.log

# Benchmark outputs (regenerate with python -m benchmarks.run)
apps/api/benchmarks/results/

# Launch-video renders: 11 MB of generated frames, audio and MP4. Rebuild, don't keep.
brag-output/

# Scratch reference material dropped in while designing the templates — screenshots,
# PDFs and a 2 MB mockup. Source of ideas, not source code.
resume-temp/
